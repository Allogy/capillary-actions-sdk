@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <https://primer.org/> .

ns1:all_users a foaf:Group ;
    foaf:member ns1:malakhi .

ns1:academic_disengagement ns1:reliability ns1:accuracy_level_-30 .

ns1:basic_understanding_of_biological_systems ns1:reliability ns1:accuracy_level_130 .

