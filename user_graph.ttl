    ns1:has_skill ns1:basic_understanding_of_biological_systems,
        ns1:curiosity,
        ns1:scientific_curiosity ;
    ns1:involves ns1:cell_signaling .

ns1:lifespan_development_class a ns1:class ;
    ns1:involves ns1:a_lot_of_reading,
        ns1:old-fashioned ;
    ns1:work_on ns1:empathy,
        ns1:preference_for_quantitative_subjects .

ns1:malakhi a foaf:Person ;
    foaf:name "Malakhi" ;
    ns1:dislikes_class ns1:british_literature_class_in_high_school,
        ns1:lifespan_development_class,
        ns1:pre-calculus_class ;
    ns1:enjoys_class ns1:introductory_biology_class,
        ns1:physics_ii_class,
        ns1:social_justice_in_spanish-speaking_countries_class ;
    ns1:interested_in ns1:editing_videos,
        ns1:minecraft .

