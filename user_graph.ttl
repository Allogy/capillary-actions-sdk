        ns1:patience,
        ns1:tolerance .

ns1:curiosity ns1:reliability ns1:accuracy_level_130 .

ns1:digital_media_production ns1:reliability ns1:accuracy_level_30 .

ns1:editing_videos a ns1:interest ;
    ns1:has_skill ns1:digital_media_production,
        ns1:visual_storytelling ;
    ns1:involves ns1:taking_photos_and_videos_and_creatively_stringing_them_together_to_make_something_exciting .

ns1:empathy ns1:reliability ns1:accuracy_level_-55 .

ns1:intercultural_competency ns1:reliability ns1:accuracy_level_80 .

